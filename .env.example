APP_ENV=development
LOG_LEVEL=info
LOG_DIR=./logs
LOG_RETENTION_DAYS=30

DATABASE_URL=postgres://solva_app_login:solva_app_dev@localhost:5432/solva
DATABASE_OWNER_URL=postgres://solva_owner:solva_owner_dev@localhost:5432/solva
TEST_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

BETTER_AUTH_SECRET=replace-with-random-secret-min-32-chars
AUTH_COOKIE_SECURE=false
TRUSTED_PROXY_CIDR=172.16.0.0/12
PUBLIC_BASE_URL=http://localhost:3000
ASSETS_DIR=./assets
SOURCEMAP_DIR=./sourcemaps
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Application rate limits (ARCHITECTURE §6.9.3)
RL_LOGIN_SCHEDULE_SEC=0,0,0,30,60,120,300,900
RL_LOGIN_RESET_AFTER_SEC=900
RL_LOGIN_SLUG_ALERT_THRESHOLD=100
RL_LOGIN_SLUG_ALERT_WINDOW_SEC=900
RL_LOGIN_SLUG_TARPIT_MS=2000
RL_LOGIN_IPSLUG_POINTS=100
RL_LOGIN_IPSLUG_WINDOW_SEC=900
RL_LOGIN_IPSLUG_BLOCK_SEC=900
RL_LOGIN_KEY_MAX=10000
RL_ENROLL_IP_POINTS=10
RL_ENROLL_IP_WINDOW_SEC=300
RL_ENROLL_SLUG_POINTS=30
RL_ENROLL_SLUG_WINDOW_SEC=300
RL_REDEEM_EMAIL_POINTS=5
RL_REDEEM_EMAIL_WINDOW_SEC=900
RL_REDEEM_SLUG_POINTS=30
RL_REDEEM_SLUG_WINDOW_SEC=300
RL_REDEEM_IPSLUG_POINTS=10
RL_REDEEM_IPSLUG_WINDOW_SEC=300
RL_ISSUE_TENANT_PER_HOUR=20
RL_ISSUE_EMAIL_PER_HOUR=5
RL_SLUG_PROBE_POINTS=60
RL_SLUG_PROBE_WINDOW_SEC=300
RL_BAD_CREDENTIAL_IP_POINTS=30
RL_BAD_CREDENTIAL_IP_WINDOW_SEC=300
RL_DEVICE_PUSH_PER_MIN=60
RL_DEVICE_PULL_PER_MIN=30
RL_DEVICE_PING_PER_MIN=30
RL_DEVICE_HANDOVER_PER_MIN=30
RL_DEVICE_LOG_PER_10MIN=20
RL_FULL_RESYNC_PER_HOUR=1
RL_PUSH_CONCURRENCY=8
RL_REPORT_CONCURRENCY_PER_TENANT=2
