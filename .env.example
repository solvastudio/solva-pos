APP_ENV=development
LOG_LEVEL=info
LOG_DIR=./logs
LOG_RETENTION_DAYS=30

DATABASE_URL=postgres://solva_app_login:solva_app_dev@localhost:5432/solva
DATABASE_OWNER_URL=postgres://solva_owner:solva_owner_dev@localhost:5432/solva
TEST_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

BETTER_AUTH_SECRET=replace-with-random-secret-min-32-chars
TRUSTED_PROXY_CIDR=172.16.0.0/12
ASSETS_DIR=./assets
SOURCEMAP_DIR=./sourcemaps
