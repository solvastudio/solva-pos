    "@tanstack/react-start": "1.169.4",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "rate-limiter-flexible": "11.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "uuidv7": "1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@size-limit/file": "14.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
