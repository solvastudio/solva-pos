{
  "name": "solva-pos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/local.mjs vite dev",
    "build": "vite build",
    "build:ops": "node scripts/build-ops.mjs",
    "start": "node dist/ops/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && npm run lint:arch",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "test:unit": "vitest run --project unit",
    "test:db": "node scripts/local.mjs vitest run --project db --exclude \"**/pull-bench.int.test.ts\" --passWithNoTests",
    "bench:pull": "node scripts/local.mjs vitest run --project db tests/integration/pull-bench.int.test.ts",
    "db:migrate": "node scripts/local.mjs tsx scripts/db-migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:up": "docker compose up -d db --wait",
    "db:down": "docker compose down",
    "size": "size-limit",
    "logs:find": "tsx scripts/logs-find.ts",
    "guard:bundle": "node scripts/ci/bundle-guard.mjs",
    "audit:verify": "node scripts/local.mjs tsx scripts/ops/verify-audit-chain.ts",
    "seed:dev-tenant": "node scripts/local.mjs tsx scripts/seed/dev-tenant.ts",
    "seed:dev-owner": "node scripts/local.mjs tsx scripts/seed/dev-owner.ts",
    "ops:create-platform-admin": "node scripts/local.mjs tsx scripts/ops/create-platform-admin.ts",
    "test:nginx": "node scripts/ci/nginx-check.mjs",
    "e2e:build": "node scripts/ci/e2e-build.mjs",
    "e2e:setup": "node scripts/local.mjs tsx tests/e2e/global-setup.ts",
    "test:e2e": "node scripts/local.mjs playwright test",
    "gate:f1": "node scripts/ci/gate-f1.mjs",
    "gate:f2": "node scripts/ci/gate-f2.mjs",
    "gate:f3": "node scripts/ci/gate-f3.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@jridgewell/trace-mapping": "0.3.31",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "barcode-detector": "3.2.4",
    "better-auth": "1.7.25",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "drizzle-orm": "0.45.4",
    "hash-wasm": "4.13.0",
    "i18next": "26.5.11",
    "lucide-react": "1.63.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-roll": "4.0.0",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "rate-limiter-flexible": "11.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "tailwind-merge": "3.7.0",
    "uuidv7": "1.2.1",
    "vite-plugin-pwa": "2.0.0",
    "workbox-build": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-window": "7.4.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@size-limit/file": "14.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "dependency-cruiser": "18.8.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "size-limit": "14.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
